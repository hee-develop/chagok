{
  "expo": {
    "name": "차곡",
    "slug": "chagok",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chagok.phone"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.chagok.phone"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-calendar",
        {
          "calendarPermission": "고른 캘린더의 오늘·내일 일정을 읽어 차에 보내기 위해 캘린더 접근이 필요해요."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "차 화면의 QR을 찍어 차와 연결하기 위해 카메라가 필요해요.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ],
    "scheme": "chagok"
  }
}
