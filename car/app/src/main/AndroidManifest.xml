<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 기어·시동(AAOS CarPropertyManager) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <!-- NaviHelper 소요 시간 조회(requestTrip)·길안내 요청(requestRoute), TTS, STT -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <!-- 위치: 달린 뒤 P단의 일정 장소 도착·집 하차 판단(런타임 동의, 설명 카드 뒤 요청). 포그라운드만 쓰고 백그라운드 위치 권한은 두지 않는다. 없어도 나머지 기능은 동작한다 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ChagokApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chagok">

        <!-- CCP(회전식 컨트롤러) 미지원 선언. 터치·음성만으로 조작한다 -->
        <meta-data
            android:name="com.hmg.rotary.ROTARY_SUPPORTED"
            android:value="false" />

        <!-- screenOrientation은 지정하지 않는다. 지정하지 않으면 portrait(window 한 칸)로 열리고,
             이미 landscape 앱이 떠 있으면 landscape(window 두 칸)로 열린다. 화면은 두 방향 모두 같은 카드를 쓴다 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 주행 중에는 카드를 접고 말하지 않으며, 남는 것은 누를 수 없는 정적 한 줄 칩뿐이라 DO로 선언한다 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>
</manifest>
