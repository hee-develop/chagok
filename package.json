{
  "name": "chagok",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "server:dev": "pnpm --filter @chagok/server dev",
    "server:test": "pnpm --filter @chagok/server test",
    "phone:start": "pnpm --filter @chagok/phone start",
    "typecheck": "pnpm -r --workspace-concurrency=1 exec tsc --noEmit",
    "e2e:car": "bash scripts/e2e-car.sh",
    "car:test": "cd car && ./gradlew :app:testDebugUnitTest",
    "phone:test": "pnpm --filter @chagok/phone test",
    "e2e:phone": "bash scripts/e2e-phone.sh",
    "demo:pt": "bash scripts/pt-demo.sh"
  }
}
